{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recommendations/v1",
  "type": "object",
  "required": ["schema_version", "run_id", "arms", "user_count", "complete"],
  "properties": {
    "schema_version": {"const": "recommendations/v1"},
    "run_id": {"type": "string"},
    "arms": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "user_count": {"type": "integer", "minimum": 1},
    "complete": {"const": true}
  }
}
