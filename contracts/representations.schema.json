{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "representations/v1",
  "type": "object",
  "required": ["schema_version", "run_id", "modality", "catalog_size", "branches", "complete"],
  "properties": {
    "schema_version": {"const": "representations/v1"},
    "run_id": {"type": "string"},
    "modality": {"enum": ["visual_only", "multimodal"]},
    "catalog_size": {"type": "integer", "minimum": 1},
    "branches": {"type": "object", "minProperties": 1},
    "complete": {"const": true}
  }
}
