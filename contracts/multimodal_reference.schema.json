{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multimodal-reference/v1",
  "type": "object",
  "required": ["schema_version", "content_id", "scene_idx", "timeline"],
  "properties": {
    "schema_version": {"const": "multimodal-reference/v1"},
    "content_id": {"type": "string", "minLength": 1},
    "scene_idx": {"type": "integer", "minimum": 0},
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_idx", "timestamp", "raw_asr", "raw_ocr"],
        "properties": {
          "shot_idx": {"type": "integer", "minimum": 0},
          "timestamp": {"type": "integer", "minimum": 0},
          "raw_asr": {"type": "string"},
          "raw_ocr": {"type": "string"}
        }
      }
    }
  }
}
