{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-context/v1",
  "type": "object",
  "required": ["schema_version", "content_id", "context_type", "backend", "modality", "status", "text", "evidence_fingerprint", "model_fingerprint"],
  "properties": {
    "schema_version": {"const": "video-context/v1"},
    "content_id": {"type": "string", "minLength": 1},
    "context_type": {"enum": ["graph", "desc"]},
    "backend": {"enum": ["ondevice", "gemini"]},
    "modality": {"enum": ["visual_only", "multimodal"]},
    "status": {"const": "complete"},
    "text": {"type": "string", "minLength": 1},
    "evidence_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
