{
  "schema_version": "microlens-import-config/v1",
  "dataset_id": "microlens-100k",
  "source": {
    "videos_dir": "../data/microlens_100k/MicroLens-100k-videos",
    "titles_csv": "../data/microlens_100k/MicroLens-100k_title_en.csv",
    "tags_csv": "../data/microlens_100k/tags_to_summary.csv",
    "pairs_tsv": "../data/microlens_100k/MicroLens-100k_pairs_1k.tsv",
    "selection_jsonl": null,
    "smoke_selection_jsonl": null
  },
  "output_root": "output/microlens_100k_pilot_1k",
  "assets_root": "source_assets",
  "processing_config_path": "config/video_data_collection.json",
  "pilot": {
    "size": 1000,
    "smoke_size": 32,
    "seed": 42,
    "minimum_per_category": 5
  },
  "sampling": {
    "shot_interval": "fixed_30s",
    "interval_seconds": 10,
    "frames_per_scene": 3,
    "ocr_fps": 1,
    "resize_mode": "contain_pad",
    "padding_color": "black"
  },
  "metadata_defaults": {
    "channel": "unknown",
    "upload_date": "unknown",
    "description": ""
  },
  "outputs": {
    "inventory_jsonl": "manifests/microlens_100k_inventory.jsonl",
    "failures_jsonl": "manifests/microlens_100k_import_failures.jsonl",
    "selection_json": "manifests/microlens_100k_selection.json",
    "pilot_manifest_csv": "manifests/microlens_100k_pilot_1k.csv",
    "smoke_manifest_csv": "manifests/microlens_100k_smoke.csv",
    "pilot_categories_jsonl": "manifests/microlens_100k_pilot_1k_categories.jsonl",
    "smoke_categories_jsonl": "manifests/microlens_100k_smoke_categories.jsonl"
  }
}
